# Empty when the frontend is served by the API; set the server LAN address for Vite.
VITE_API_URL=
# VITE_API_URL=http://192.168.1.10:8000

# Backend defaults to loopback. On the store server explicitly opt in to LAN:
# C4_API_HOST=0.0.0.0
C4_API_HOST=127.0.0.1
C4_API_PORT=8000
# Address opened automatically on the server computer by desktop.py.
C4_BROWSER_HOST=127.0.0.1
# Allowed development origins; keep this list limited to the actual frontend hosts.
C4_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
